Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Classes\monitorapp]
@="URL:Monitor App Protocol"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\monitorapp\shell]

[HKEY_CURRENT_USER\Software\Classes\monitorapp\shell\open]

[HKEY_CURRENT_USER\Software\Classes\monitorapp\shell\open\command]
@="\"C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe\" -NoProfile -WindowStyle Hidden -Command \"$c=[char]92; $s=[string]$c; $url='%1'.Trim('`\"'''); $log='C:'+$s+'monitorapp.log'; Add-Content -Path $log -Value '--- Início ---'; Add-Content -Path $log -Value ('URL original: '+$url); $path=[System.Uri]::UnescapeDataString($url); $path=$path -replace '(?i)^monitorapp:',''; $path=$path -replace '/',$s; $path=$path -replace ($s+$s+'+'),$s; $path=$path.TrimStart($c); Add-Content -Path $log -Value ('Path base limpo: '+$path); if($path -match ('^([A-Za-z])[:'+$s+$s+']+(.*)')){ $path=$Matches[1]+':'+$s+$Matches[2]; Add-Content -Path $log -Value ('Reconstruído para Disco Local: '+$path); }else{ $path=$s+$s+$path; Add-Content -Path $log -Value ('Reconstruído para Caminho de Rede: '+$path); }; try{ Add-Content -Path $log -Value 'A abrir...'; & $env:SystemRoot'\\System32\\cmd.exe' /c start \"\" \"$path\"; }catch{ Add-Content -Path $log -Value '*** EXCEÇÃO ***'; Add-Content -Path $log -Value ('Mensagem: '+$_.Exception.Message); Add-Content -Path $log -Value ('Tipo: '+$_.Exception.GetType().FullName); Add-Content -Path $log -Value ('StackTrace: '+$_.ScriptStackTrace); throw; }finally{ Add-Content -Path $log -Value '--- Fim ---'; }\""